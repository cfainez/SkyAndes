# Copie este archivo como .env y ajuste los valores.
# Nunca versione el archivo .env real ni credenciales de producción.

# --- Django ---------------------------------------------------------------
# Genere una clave propia, por ejemplo:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambie-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos --------------------------------------------------------
# sqlite (por defecto) o postgresql
DB_ENGINE=postgresql
DB_NAME=skyandes
DB_USER=skyandes
DB_PASSWORD=cambie-esta-clave
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Correo ---------------------------------------------------------------
# Desarrollo: los correos se imprimen en la consola.
# Producción: use el backend SMTP de Django y complete los datos.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.cl
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@skyandes.cl
# EMAIL_HOST_PASSWORD=cambie-esta-clave
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@skyandes.cl
